  (global_label "LED_O_A" (shape passive) (at 300.95 262.00 180)
    (fields_autoplaced yes)
    (effects (font (size 1.27 1.27)) (justify right)) (uuid "00000000-0000-0000-0000-000000000089"))
  (global_label "GND" (shape passive) (at 339.05 262.00 0)
    (fields_autoplaced yes)
    (effects (font (size 1.27 1.27)) (justify left)) (uuid "00000000-0000-0000-0000-00000000008a"))
  (text "GROUNDING - not expressible in a schematic, see the harness drawing:" (at 40.00 25.00 0)
    (effects (font (size 1.27 1.27)) (justify left)) (uuid "00000000-0000-0000-0000-00000000008b"))
  (text "every GND below is one net here, but in the build each subsystem gets its" (at 40.00 29.00 0)
    (effects (font (size 1.27 1.27)) (justify left)) (uuid "00000000-0000-0000-0000-00000000008c"))
  (text "own return to the PDB negative plane. Never daisy-chain a ground." (at 40.00 33.00 0)
    (effects (font (size 1.27 1.27)) (justify left)) (uuid "00000000-0000-0000-0000-00000000008d"))
  (text "A1 V- carries the motor return: 16 AWG, short. A1 GND is the signal" (at 40.00 41.00 0)
    (effects (font (size 1.27 1.27)) (justify left)) (uuid "00000000-0000-0000-0000-00000000008e"))
  (text "reference for TX/RX: 26 AWG, twisted with them. They are separate pads." (at 40.00 45.00 0)
    (effects (font (size 1.27 1.27)) (justify left)) (uuid "00000000-0000-0000-0000-00000000008f"))
  (text "C1 mounts across A1's own V+ / GND pads, not at the PDB." (at 40.00 53.00 0)
    (effects (font (size 1.27 1.27)) (justify left)) (uuid "00000000-0000-0000-0000-000000000090"))
  (text "A1 pin 3 (BEC 5V) is an OUTPUT - leave unconnected, U1 is fed from the PDB." (at 40.00 57.00 0)
    (effects (font (size 1.27 1.27)) (justify left)) (uuid "00000000-0000-0000-0000-000000000091"))
  (text "R1 is required: GPIO34-39 have no internal pull resistor." (at 40.00 61.00 0)
    (effects (font (size 1.27 1.27)) (justify left)) (uuid "00000000-0000-0000-0000-000000000092"))
  (text "DRV_PWM is bring-up only and must never be driven while the UART is" (at 40.00 65.00 0)
    (effects (font (size 1.27 1.27)) (justify left)) (uuid "00000000-0000-0000-0000-000000000093"))
  (text "commanding torque." (at 40.00 69.00 0)
    (effects (font (size 1.27 1.27)) (justify left)) (uuid "00000000-0000-0000-0000-000000000094"))
  (text "GPIO5 (ESC_DIR_PIN in pins.h) has NO destination: this board's input header" (at 40.00 77.00 0)
    (effects (font (size 1.27 1.27)) (justify left)) (uuid "00000000-0000-0000-0000-000000000095"))
  (text "is V- 5V TX RX PWM GND V+ - there is no direction pin. Bidirectional drive" (at 40.00 81.00 0)
    (effects (font (size 1.27 1.27)) (justify left)) (uuid "00000000-0000-0000-0000-000000000096"))
  (text "over PWM would have to be encoded in the pulse width instead." (at 40.00 85.00 0)
    (effects (font (size 1.27 1.27)) (justify left)) (uuid "00000000-0000-0000-0000-000000000097"))
  (sheet_instances (path "/" (page "1")))
)
